extends partials/layout

prepend pageTitle
  - var title = "Sacramento Budget Charts and Posters"

block bodyClass
  - var slug = "visuals"

block content
  .container
    .row
      .col-md-12
        h2.subheader Sacramento Budget Data in Chart Form

    .row
      .col-md-4
        a(href="/adopted-budget-flow")
          h3 Cash Flow
          img.img-responsive(src="/images/flow-thumb-1517.jpg" alt="")
      .col-md-4
        a(href="/adopted-budget-tree")
          h3 Detailed Budget Breakdown
          img.img-responsive(src="/images/tree-thumb-1517.jpg" alt="")

    hr
    
    .row
      .col-md-12
        h2.subheader Sacramento Budget Features 
    
    .row
      .col-md-4
        a(href="/measure-z")
          h3 Focus on Measure Z: How does Sacramento fund violence prevention?
          img.img-responsive(src="/images/home/measureZ12.png")
